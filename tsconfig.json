{
  "compilerOptions": {
    /* --- Основные настройки сборки --- */
    "target": "esnext",                /* Собираем в современный JS (Node 18+ поддерживает ES2022 полностью) */
    "module": "NodeNext",              /* Важно для поддержки imports (#core/...) и Top-level await */
    "moduleResolution": "NodeNext",    /* Современный алгоритм разрешения модулей Node.js */
    "lib": ["ESNext"],                 /* Включаем новейшие фичи языка */

    "rootDir": "./",
    "outDir": "./build",

    "sourceMap": false,

    /* --- Строгость (Type Checking) --- */
    "strict": true,
    "alwaysStrict": true,
    "strictNullChecks": false,
    "strictFunctionTypes": true,

    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitAny": false,

    /* --- Совместимость и производительность --- */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "removeComments": true,

    /* --- Декораторы --- */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "paths": {
      "#core/*": ["./src/core/*"],

      "#handler": ["./src/handlers/index"],
      "#handler/*": ["./src/handlers/*"],
      "#worker/*": ["./src/workers/*"],

      "#structures/*": ["./src/structures/*"],
      "#structures": ["./src/structures/index"],

      "#db/": ["./src/structures/database/index"],
      "#db/app": ["./src/index"],
      "#db/env": ["./src/structures/manager/environment"],
      "#db/worker": ["./src/structures/database/index.worker"],

      // Нативные модули написанные на Rust
      "#native": ["./src/structures/manager/n-api.ts"],
    }
  },

  "include": [
    "src/**/*"
  ],


  "exclude": [
    "node_modules"
  ]
}
